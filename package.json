{
  "name": "clean-house-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build_apk": "npx eas build -p android --profile preview --local",
    "eas_update:preview": "npx eas update --branch preview --message \"fix bugs\"",
    "eas_update:preview:android": "npx eas update --branch preview -p android --message \"fix bugs\"",
    "eas_update:preview:ios": "npx eas update --branch preview -p ios --message \"fix bugs\"",
    "eas_update:production": "npx eas update --branch production --message \"production update\"",
    "eas_update:production:android": "npx eas update --branch production -p android --message \"production update\"",
    "eas_update:production:ios": "npx eas update --branch production -p ios --message \"production update\"",
    "build_dev": "npx eas build --profile development-simulator --platform android --local",
    "build_android_aab": "npx eas build --profile production --platform android",
    "expo_cred_android": "eas update:configurexpo credentials:manager -p android",
    "build_dev_ios": "npx eas build --profile development-simulator --platform ios",
    "uplad_ios": "npx eas submit -p ios --latest",
    "build_ios": "npx eas build -p ios",
    "build_preview_ios": "npx eas build -p ios --profile preview",
    "install_check_deep": "npx expo install --check",
    "format": "prettier --write .",
    "prebuild": "expo prebuild --platform ios",
    "doctor": "npx expo-doctor@latest",
    "eas_configure": "npx eas build:configure"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.1",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "22.2.1",
    "@react-native-firebase/messaging": "22.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.0",
    "@react-navigation/native": "^7.3.14",
    "@tanstack/react-query": "^5.85.5",
    "axios": "^1.11.0",
    "expo": "^54.0.0",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "input-otp-native": "^0.5.0",
    "qs": "^6.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.81.5",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-mask-input": "^1.2.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "sonner-native": "^0.21.1",
    "yup": "^1.7.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/qs": "^6.14.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@notifee/react-native"
        ]
      }
    }
  }
}
